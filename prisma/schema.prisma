// Viphuanan Resort — Prisma Schema v1.6
// Phase 0–4 + Phase 5: Registration รร.3/4 + Phase 7: Housekeeping & Maintenance

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  MANAGER
  FRONT_DESK
  ACCOUNTING
  HOUSEKEEPING
}

enum RoomStatus {
  VACANT
  RESERVED
  OCCUPIED
  DIRTY
  CLEANING
  INSPECTED
  OUT_OF_ORDER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  RESTORE
  LOGIN
  LOGOUT
  VERIFY
  REJECT
  APPROVE
  POST
  ADJUST
  REFUND
  EXPORT
  CHECKIN
  CHECKOUT
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  NO_SHOW
  CHECKED_IN
  CHECKED_OUT
}

enum BookingSource {
  DIRECT
  WALK_IN
  PHONE
  WEBSITE
  BOOKING_COM
  AGODA
  OTHER_OTA
  OTHER
}

enum StayStatus {
  EXPECTED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum IdType {
  THAI_ID
  PASSPORT
  DRIVING_LICENSE
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  PROMPTPAY
  PAYMENT_GATEWAY
  OTA
  OTHER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentPurpose {
  DEPOSIT
  BALANCE
  FULL
  EXTRA_CHARGE
}

enum DepositStatus {
  EXPECTED
  RECEIVED
  APPLIED
  PARTIALLY_REFUNDED
  REFUNDED
  FORFEITED
}

enum ReceivableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum RefundStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
}

enum DocumentType {
  PAYMENT_SLIP
  INVOICE
  RECEIPT
  GUEST_ID
  CONTRACT
  OTHER
}

enum DocumentStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
  ARCHIVED
}

enum OcrStatus {
  NOT_STARTED
  PROCESSING
  COMPLETED
  FAILED
}

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalStatus {
  DRAFT
  PENDING_REVIEW
  VERIFIED
  APPROVED
  POSTED
}

enum JournalType {
  REVENUE
  EXPENSE
  ADJUSTMENT
  REVERSAL
  CORRECTION
  OTHER
}

enum ExpenseCategory {
  UTILITIES
  MAINTENANCE
  SUPPLIES
  STAFFING
  MARKETING
  DEPRECIATION
  OTHER
}

enum HousekeepingStatus {
  PENDING
  IN_PROGRESS
  DONE
  INSPECTED
  CANCELLED
}

enum HousekeepingPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum HousekeepingType {
  CHECKOUT_CLEAN   // Post-checkout full clean
  DAILY_SERVICE    // Stayover service
  DEEP_CLEAN
  INSPECTION
  OTHER
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// RR3 = Thai guests daily hotel register; RR4 = foreign guests police report; TM30 = immigration notification
enum RegistrationType {
  RR3
  RR4
  TM30
}

enum RegistrationStatus {
  PENDING
  SUBMITTED
  OVERDUE
  CANCELLED
}

// ─── AUTH ─────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          UserRole  @default(FRONT_DESK)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  sessions  Session[]
  auditLogs AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ─── ROOMS ────────────────────────────────────────────────────────────────────

model RoomType {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms Room[]

  @@map("room_types")
}

model Room {
  id           String     @id @default(cuid())
  roomNumber   String     @unique
  roomTypeId   String?
  basePrice    Decimal    @default(0) @db.Decimal(10, 2)
  status       RoomStatus @default(VACANT)
  active       Boolean    @default(true)
  description  String?
  archivedAt   DateTime?
  archivedBy   String?
  archiveReason String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roomType            RoomType?            @relation(fields: [roomTypeId], references: [id])
  stays               Stay[]
  bookings            Booking[]
  housekeepingTasks   HousekeepingTask[]
  maintenanceRequests MaintenanceRequest[]

  @@map("rooms")
}

// ─── GUESTS ───────────────────────────────────────────────────────────────────

model Guest {
  id           String    @id @default(cuid())
  title        String?
  firstName    String
  lastName     String
  fullName     String
  gender       Gender    @default(UNSPECIFIED)
  nationality  String?
  dateOfBirth  DateTime?
  idType       IdType?
  idNumber     String?
  idIssuer     String?
  address      String?
  occupation   String?
  phone        String?
  email        String?
  notes        String?
  active       Boolean   @default(true)
  archivedAt   DateTime?
  archivedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings            Booking[]
  stays               Stay[]
  documents           Document[]
  registrationRecords RegistrationRecord[]

  @@index([firstName, lastName])
  @@index([idNumber])
  @@index([phone])
  @@map("guests")
}

// ─── BOOKINGS ─────────────────────────────────────────────────────────────────

model Booking {
  id               String        @id @default(cuid())
  bookingReference String        @unique
  guestId          String
  roomId           String
  source           BookingSource @default(DIRECT)
  checkInDate      DateTime      @db.Date
  checkOutDate     DateTime      @db.Date
  numberOfNights   Int
  roomRate         Decimal       @db.Decimal(10, 2)
  discount         Decimal       @default(0) @db.Decimal(10, 2)
  grossAmount      Decimal       @db.Decimal(10, 2)
  status           BookingStatus @default(CONFIRMED)
  notes            String?
  createdBy        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  guest  Guest  @relation(fields: [guestId], references: [id])
  room   Room   @relation(fields: [roomId], references: [id])
  stays               Stay[]
  payments            Payment[]
  deposit             Deposit?
  receivables         Receivable[]
  documents           Document[]
  journalEntries      JournalEntry[]
  registrationRecords RegistrationRecord[]

  @@index([guestId])
  @@index([roomId])
  @@index([checkInDate])
  @@map("bookings")
}

// ─── STAYS ────────────────────────────────────────────────────────────────────

model Stay {
  id              String     @id @default(cuid())
  bookingId       String
  guestId         String
  roomId          String
  actualCheckIn   DateTime?
  actualCheckOut  DateTime?
  status          StayStatus @default(EXPECTED)
  notes           String?
  checkedInBy     String?
  checkedOutBy    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  booking             Booking              @relation(fields: [bookingId], references: [id])
  guest               Guest                @relation(fields: [guestId], references: [id])
  room                Room                 @relation(fields: [roomId], references: [id])
  registrationRecords RegistrationRecord[]

  @@index([bookingId])
  @@index([guestId])
  @@index([roomId])
  @@index([status])
  @@map("stays")
}

// ─── PAYMENTS ────────────────────────────────────────────────────────────────

// A single payment event (cash received, transfer slip uploaded, etc.)
// revenue = booking.grossAmount, NOT sum(payments) — deposits are NOT double-counted
model Payment {
  id              String         @id @default(cuid())
  paymentReference String        @unique
  bookingId       String
  amount          Decimal        @db.Decimal(10, 2)
  method          PaymentMethod
  purpose         PaymentPurpose
  status          PaymentStatus  @default(PENDING)
  transactionRef  String?        // Bank ref / slip ref
  paidAt          DateTime?      // Actual payment datetime
  verifiedBy      String?
  verifiedAt      DateTime?
  notes           String?
  createdBy       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  booking     Booking              @relation(fields: [bookingId], references: [id])
  allocations PaymentAllocation[]
  refunds     Refund[]

  @@index([bookingId])
  @@index([status])
  @@index([paidAt])
  @@map("payments")
}

// Deposit tracked separately — applied against the booking's balance at check-out
model Deposit {
  id          String        @id @default(cuid())
  bookingId   String        @unique  // one deposit per booking
  amount      Decimal       @db.Decimal(10, 2)
  status      DepositStatus @default(EXPECTED)
  paymentId   String?       // Reference to the Payment that funded this deposit (no FK — avoids circular rel)
  appliedAt   DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("deposits")
}

// Links one Payment to one Booking for multi-booking scenarios (OTA, group bookings)
model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  bookingId String
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([bookingId])
  @@map("payment_allocations")
}

// Amount owed but not yet paid (e.g. OTA channel billing)
model Receivable {
  id          String           @id @default(cuid())
  bookingId   String
  description String
  amount      Decimal          @db.Decimal(10, 2)
  amountPaid  Decimal          @default(0) @db.Decimal(10, 2)
  dueDate     DateTime?        @db.Date
  status      ReceivableStatus @default(OPEN)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([status])
  @@map("receivables")
}

// Refund against a specific Payment — immutable audit trail
model Refund {
  id          String       @id @default(cuid())
  paymentId   String
  amount      Decimal      @db.Decimal(10, 2)
  reason      String
  status      RefundStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  completedAt DateTime?
  notes       String?
  createdBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

// ─── DOCUMENTS ────────────────────────────────────────────────────────────────

// Immutable after upload — never edit the stored file, only change status/review fields
// AI suggests, human verifies — ocrConfidence HIGH does NOT auto-verify
model Document {
  id              String         @id @default(cuid())
  fileName        String
  storagePath     String
  mimeType        String
  fileSize        Int
  fileHash        String

  documentType    DocumentType   @default(OTHER)
  status          DocumentStatus @default(PENDING_REVIEW)

  bookingId       String?
  guestId         String?
  uploadedBy      String?

  ocrStatus       OcrStatus      @default(NOT_STARTED)
  ocrRawText      String?
  ocrConfidence   Float?
  ocrExtracted    Json?

  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNotes     String?
  rejectionReason String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  booking Booking? @relation(fields: [bookingId], references: [id])
  guest   Guest?   @relation(fields: [guestId], references: [id])

  @@index([status])
  @@index([bookingId])
  @@index([guestId])
  @@index([createdAt])
  @@map("documents")
}

// ─── ACCOUNTING ───────────────────────────────────────────────────────────────

model ChartOfAccount {
  id          String          @id @default(cuid())
  code        String          @unique  // e.g. "4001", "5001"
  name        String
  category    AccountCategory
  description String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  debitLines  JournalLine[]   @relation("DebitAccount")
  creditLines JournalLine[]   @relation("CreditAccount")

  @@index([category])
  @@map("chart_of_accounts")
}

// Immutable after POSTED — use Reversal or Adjustment entries to correct
model JournalEntry {
  id          String        @id @default(cuid())
  entryNumber String        @unique
  type        JournalType
  status      JournalStatus @default(DRAFT)
  entryDate   DateTime      @db.Date
  description String
  bookingId   String?
  paymentId   String?       // Link to the Payment that triggered this entry

  submittedBy  String?
  submittedAt  DateTime?
  verifiedBy   String?
  verifiedAt   DateTime?
  approvedBy   String?
  approvedAt   DateTime?
  postedBy     String?
  postedAt     DateTime?

  reversalOf  String?       // ID of the POSTED entry this reversal is for
  adjustmentOf String?      // ID of the POSTED entry this adjusts

  createdBy   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lines   JournalLine[]
  booking Booking?      @relation(fields: [bookingId], references: [id])

  @@index([status])
  @@index([entryDate])
  @@index([bookingId])
  @@map("journal_entries")
}

// Each line is either a debit or credit on a specific account
model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  debitAccountId String?
  creditAccountId String?
  amount         Decimal  @db.Decimal(10, 2)
  description    String?
  createdAt      DateTime @default(now())

  journalEntry   JournalEntry    @relation(fields: [journalEntryId], references: [id])
  debitAccount   ChartOfAccount? @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount  ChartOfAccount? @relation("CreditAccount", fields: [creditAccountId], references: [id])

  @@index([journalEntryId])
  @@map("journal_lines")
}

// Direct expense entry (creates a JournalEntry internally when posted)
model Expense {
  id              String          @id @default(cuid())
  expenseDate     DateTime        @db.Date
  category        ExpenseCategory @default(OTHER)
  description     String
  amount          Decimal         @db.Decimal(10, 2)
  vendor          String?
  receiptRef      String?         // Document ID or reference
  journalEntryId  String?         // Linked journal once posted
  createdBy       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([expenseDate])
  @@index([category])
  @@map("expenses")
}

// ─── REGISTRATION ─────────────────────────────────────────────────────────────

// Auto-created at check-in. RR3 for Thai guests, RR4+TM30 for foreign guests.
// dueAt = midnight same day for RR3; checkIn + 24h for RR4/TM30.
model RegistrationRecord {
  id               String             @id @default(cuid())
  bookingId        String
  stayId           String
  guestId          String

  registrationType RegistrationType
  status           RegistrationStatus @default(PENDING)

  checkInDate      DateTime
  roomNumber       String
  // Denormalized snapshot so print forms remain accurate if guest record changes
  guestName        String
  nationality      String?
  idType           String?
  idNumber         String?

  dueAt            DateTime           // Submission deadline
  submittedBy      String?
  submittedAt      DateTime?
  submissionRef    String?            // Government reference / confirmation number
  notes            String?

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id])
  stay     Stay    @relation(fields: [stayId], references: [id])
  guest    Guest   @relation(fields: [guestId], references: [id])

  @@index([status])
  @@index([bookingId])
  @@index([guestId])
  @@index([dueAt])
  @@index([checkInDate])
  @@map("registration_records")
}

// ─── HOUSEKEEPING ─────────────────────────────────────────────────────────────

// Auto-created at checkout; staff can also create manually for daily service / deep clean
model HousekeepingTask {
  id          String               @id @default(cuid())
  roomId      String
  taskType    HousekeepingType     @default(CHECKOUT_CLEAN)
  status      HousekeepingStatus   @default(PENDING)
  priority    HousekeepingPriority @default(NORMAL)
  assignedTo  String?
  notes       String?
  startedAt   DateTime?
  completedAt DateTime?
  inspectedBy String?
  inspectedAt DateTime?
  createdBy   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  room Room @relation(fields: [roomId], references: [id])

  @@index([roomId])
  @@index([status])
  @@index([createdAt])
  @@map("housekeeping_tasks")
}

// ─── MAINTENANCE ──────────────────────────────────────────────────────────────

model MaintenanceRequest {
  id          String              @id @default(cuid())
  roomId      String?
  title       String
  description String
  status      MaintenanceStatus   @default(OPEN)
  priority    MaintenancePriority @default(NORMAL)
  assignedTo  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  notes       String?
  createdBy   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  room Room? @relation(fields: [roomId], references: [id])

  @@index([roomId])
  @@index([status])
  @@index([priority])
  @@map("maintenance_requests")
}

// ─── SETTINGS ─────────────────────────────────────────────────────────────────

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@map("system_settings")
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      AuditAction
  entityType  String
  entityId    String
  beforeValue Json?
  afterValue  Json?
  reason      String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
